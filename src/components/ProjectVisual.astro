---
const { type, large = false } = Astro.props;
---
<div class:list={['project-visual', type === 'wec-bot' ? 'visual-wec' : 'visual-wesion', { large }]}>
  {type === 'wec-bot' ? (
    <div class="wec-design-cover">
      <div class="wec-cover-label"><b>WeC Bot</b><span>论坛分析 / 服务协同 / 知识维护</span></div>
      <img class="wec-cover-main" src="/assets/wec/ticket-nodes.webp" alt="WeC Bot 原始工单节点设计，配置角色、操作与流转" width="1440" height="1036" />
      <img class="wec-cover-front" src="/assets/wec/forum-design.webp" alt="已脱敏的论坛分析卡片设计" width="1168" height="480" />
    </div>
  ) : large ? (
    <div class="platform-cover">
      <span>WESION / 持续开发中</span>
      <h2>让分散的文件，成为可复用的数据。</h2>
      <div class="platform-cover-flow"><div><small>业务来源</small><b>Excel · Lists</b></div><span aria-hidden="true">→</span><div><small>统一数据基础</small><b>接入 · 解析 · 关联</b></div><span aria-hidden="true">→</span><div><small>场景应用</small><b>分析 · 查看 · 跟进</b></div></div>
    </div>
  ) : (
    <div class="wesion-case-cover">
      <div class="wesion-cover-title"><b>Bug / VOC</b><span>AI 分析 · 持续开发中</span></div>
      <img src="/assets/wesion/bug-topics.webp" alt="Bug 主题分析界面，分析数量已脱敏" width="806" height="360" />
      <div class="wesion-cover-flow"><span>问题主题</span><span>原文依据</span><span>人工核对</span></div>
    </div>
  )}
  <span class="visual-caption">{type === 'wec-bot' ? '原始设计稿 · 局部脱敏' : large ? '平台架构示意 · 非产品截图' : '真实界面局部 · 已脱敏'}</span>
</div>
