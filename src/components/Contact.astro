---
import { profile } from '../data/profile';
---
<section class="contact-section" id="contact" aria-labelledby="contact-heading">
  <div><p class="eyebrow">LET’S TALK / 保持联系</p><h2 id="contact-heading">一起，把有价值的想法<br />变成好用的产品。</h2>
  <p class="muted">关于产品岗位、项目交流，或一个值得探索的问题。</p></div>
  <div class="contact-actions">
    <a class="email-link" href={`mailto:${profile.email}`}>{profile.email}<span aria-hidden="true">↗</span></a>
    <button class="copy-email" type="button" data-email={profile.email}>复制邮箱 <span aria-hidden="true">⧉</span></button>
    <p class="copy-status" role="status" aria-live="polite"></p>
    <span class="location"><i aria-hidden="true"></i> 深圳 · SHENZHEN</span>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-email').forEach((button) => {
    button.addEventListener('click', async () => {
      const status = button.parentElement?.querySelector('.copy-status');
      try {
        if (!navigator.clipboard) throw new Error('Clipboard unavailable');
        await navigator.clipboard.writeText(button.dataset.email || '');
        if (status) status.textContent = '邮箱已复制';
      } catch {
        if (status) status.textContent = '暂时无法复制，请选中上方邮箱手动复制。';
      }
    });
  });
</script>
