---
import Base from '../layouts/Base.astro';
import '../styles/reading.css';
import legacy from '../data/legacy.json';
const items = [...legacy].sort((a,b) => b.published.localeCompare(a.published));
---
<Base title="设计作品归档" description="周国翔的交互与视觉设计积累，包含在线学习、B 端后台、车载系统和电商设计。">
  <div class="wrap reading-page archive-page"><header class="page-heading"><p class="eyebrow">Design archive</p><h1>历史作品归档</h1><p>这里保留早期的交互与视觉设计作品。<br />它们记录了我如何理解任务、组织信息，以及建立一致的体验。</p><a class="text-link" href="/work/">查看作品地图 →</a></header>
    <div class="archive-list">{items.map((item,i) => <a class="archive-item" href={`/${item.slug}/`}><img class="archive-cover" src={item.cover} alt={`${item.title}封面`} width="240" height="160" loading="lazy" /><span class="archive-number">{String(i+1).padStart(2,'0')}</span><div><h2>{item.title}</h2><p>原作品发布于 {item.published}</p></div><span aria-hidden="true">↗</span></a>)}</div>
    <p class="source-date">日期为原作品页面的发布日期，不作为项目任职或实际交付日期。历史作品保留原有访问地址。</p>
  </div>
</Base>
