---
import Base from '../layouts/Base.astro';
import Contact from '../components/Contact.astro';
import { profile, experience, education, capabilities } from '../data/profile';
---
<Base title="关于我" description="周国翔 / Sky 的职业经历：从交互与用户体验设计，到企业效率工具与 AI 应用产品。">
  <div class="wrap">
    <header class="about-hero"><p class="eyebrow">ABOUT / 关于我</p><h1>从理解人，<br />到理解业务。</h1><div class="about-intro"><p class="lead">我是周国翔，也可以叫我 Sky。</p><p>{profile.description}</p><p>从在线学习、智慧城市后台，到 SaaS 业务流程，再到企业 AI 应用，我一直在做的一件事，是让复杂的信息和任务变得清楚、可用。</p><span class="role-label">{profile.title}</span></div></header>
    <section class="about-section"><div class="section-heading"><h2>工作经历 <span>Experience</span></h2><span class="section-note">UX 是起点，产品实践在继续。</span></div>
      <div class="experience-list">{experience.map(item => <article class="experience-item"><p class="experience-date">{item.period}</p><div><h3>{item.company}</h3><p class="experience-role">{item.role}</p>{item.detail && <p class="experience-detail">{item.detail}</p>}<p class="experience-description">{item.description}</p></div></article>)}</div>
    </section>
    <section class="about-section"><div class="section-heading"><h2>专业能力 <span>Capabilities</span></h2></div><div class="capabilities">{capabilities.map(item => <article><span class="number">{item.number}</span><h3>{item.title}</h3><p>{item.description}</p><span class="small-label">{item.evidence}</span></article>)}</div></section>
    <section class="about-section"><div class="section-heading"><h2>持续探索 <span>In practice</span></h2><span class="section-note">设计与验证中的实践</span></div><div class="practice-grid"><article><p class="eyebrow">AI 辅助设计与开发</p><h3>Mind APP</h3><p>推进界面优化与设计文件整理，跑通 AI 辅助页面设计、调试开发流程。</p><span class="stage-label">设计与流程验证</span></article><article><p class="eyebrow">AI 交互探索</p><h3>VIM 5 Block</h3><p>围绕 5 个核心场景设计 AI 交互框架，梳理持续语音对话、状态反馈和异常恢复，形成交互原型与验证计划。</p><span class="stage-label">评审和验证阶段</span></article></div></section>
    <section class="about-section"><div class="section-heading"><h2>教育经历 <span>Education</span></h2></div>{education.map(item => <article class="education-item"><p class="experience-date">{item.period}</p><h3>{item.school}</h3><p>{item.description}</p></article>)}<p class="source-date">履历与项目阶段依据截至 {profile.evidenceDate} 已梳理的材料，持续更新。</p></section>
    <Contact />
  </div>
</Base>
