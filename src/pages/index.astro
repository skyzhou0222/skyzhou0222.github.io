---
import Base from '../layouts/Base.astro';
import Contact from '../components/Contact.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile, capabilities } from '../data/profile';
import { getCollection } from 'astro:content';
const projects = (await getCollection('projects')).sort((a,b) => a.data.order - b.data.order);
---
<Base>
  <div class="wrap">
    <section class="hero">
      <p class="eyebrow">PRODUCT · DESIGN · AI <span class="eyebrow-divider">/</span> SHENZHEN</p>
      <h1>让复杂的业务，<br />成为好用的产品。</h1>
      <p class="hero-role">{profile.title}</p>
      <p class="hero-description">{profile.description}</p>
      <div class="actions"><a class="button" href="#work">浏览精选案例 <span aria-hidden="true">↓</span></a><a class="text-link" href="/about/">了解我的经历 <span aria-hidden="true">↗</span></a></div>
      <div class="hero-side" aria-hidden="true"><span>理解问题</span><span>设计体验</span><span>推动实现</span><div class="hero-rule"></div><small>从想法，到验证。</small></div>
    </section>
    <section id="work" aria-labelledby="work-title">
      <div class="section-heading"><h2 id="work-title">精选项目 <span>Selected work</span></h2><span class="section-note">产品实践与设计积累 / 01—02</span></div>
      <div class="project-grid">{projects.map(project => <ProjectCard project={project} />)}</div>
    </section>
    <section class="design-section" aria-labelledby="design-title">
      <div class="section-heading"><h2 id="design-title">设计的积累 <span>Design foundations</span></h2><a class="text-link" href="/archives/">全部历史作品 <span aria-hidden="true">↗</span></a></div>
      <div class="design-grid">
        <a class="design-card" href="/ce-shi/"><div class="design-image"><img src="/assets/legacy/k12-cover.webp" width="960" height="600" alt="K12 在线英语学习平台原设计作品封面" loading="lazy" /></div><div class="project-heading"><h3>K12 在线英语学习平台</h3><span aria-hidden="true">↗</span></div><p>理解学习任务，组织清晰的操作路径。</p><span class="small-label">交互设计 · 用户研究</span></a>
        <a class="design-card" href="/b-duan-hou-tai-she-ji-gui-fan/"><div class="design-image"><img src="/assets/legacy/backend-cover.webp" width="960" height="600" alt="长春 B 端后台设计原作品封面" loading="lazy" /></div><div class="project-heading"><h3>长春 B 端后台设计</h3><span aria-hidden="true">↗</span></div><p>从复杂业务出发，建立一致的设计语言。</p><span class="small-label">B 端产品 · 组件与设计规范</span></a>
      </div>
    </section>
    <section class="method-section" aria-labelledby="method-title">
      <p class="eyebrow">ABOUT / 我的工作方式</p><h2 id="method-title">从理解人，到理解业务。</h2>
      <p class="section-intro">UX 是我的起点。现在，我把用户体验、业务流程与 AI 工具结合起来，<br class="desktop-break" />在真实问题中持续探索产品的价值与应用边界。</p>
      <div class="capabilities">{capabilities.map(item => <article><span class="number">{item.number}</span><h3>{item.title}</h3><p>{item.description}</p><span class="small-label">{item.evidence}</span></article>)}</div>
      <a class="text-link" href="/about/">更多关于我的经历 <span aria-hidden="true">↗</span></a>
    </section>
    <Contact />
  </div>
</Base>
