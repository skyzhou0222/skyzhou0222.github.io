---
import Base from '../layouts/Base.astro';
import StoryStack from '../components/StoryStack.astro';
import Contact from '../components/Contact.astro';
import { profile } from '../data/profile';
import { getWorks, type Work } from '../data/works';
import '../styles/home.css';

const works = await getWorks();
const pick = (id: string): Work => {
  const work = works.find(item => item.id === id);
  if (!work) throw new Error(`首页引用了缺失的作品 ${id}`);
  return work;
};
const forum = pick('wec-bot');
const platform = pick('wesion-ai');
const booking = pick('you-zan-wang-dian-yu-yue-xi-tong');
const learning = pick('ce-shi');
// Optional later portrait. Use a file under public/ and its public URL here.
const heroImage = { src: '', alt: '' };
const selected = [
  { work: forum, title: forum.title, subject: '论坛分析与售后协作', note: forum.summary, meta: forum.stage },
  { work: platform, title: platform.title, subject: '数据治理与 AI 分析', note: platform.summary, meta: platform.stage },
  { work: booking, title: '有赞网店预约系统', subject: '商家经营与服务预约', note: '从商家安排服务和顾客选择时段两条路径，梳理预约流程与信息层级。', meta: '历史设计作品' },
  { work: learning, title: 'K12 在线英语学习平台', subject: '在线学习体验', note: '围绕找课、上课和课后学习，组织学习中心的任务与交互。', meta: '历史设计作品' },
  ...[
    { id: 'b-duan-hou-tai-she-ji-gui-fan', title: '长春 B 端后台设计', subject: '智慧城市后台', note: '梳理跨部门后台的界面框架、通用组件与交互规范。' },
    { id: 'wang-ka-ye-wu-guan-li-hou-tai-fan-yu', title: '凡鱼网咖管理后台', subject: '业务系统设计', note: '网咖业务管理后台的历史界面与设计图集。' },
    { id: 'cha-hua-xiu-gai-de-de-xiao-dong-xiao', title: '插画与个人标志动效', subject: '视觉与动效', note: '插画修改过程的动效，以及个人标志设计。' },
  ].map(({ id, ...entry }) => ({ ...entry, work: pick(id), meta: '历史设计作品' })),
];
const crafts = [
  { title: '用户体验设计', description: '沿着实际操作，把复杂任务拆成清楚的步骤。' },
  { title: '用户研究', description: '观察用户怎样学习、怎样工作，找到卡住的那一步。' },
  { title: '业务流程设计', description: '明确谁来接手一张工单，以及怎样继续处理。' },
  { title: 'Prompt 设计', description: '为求助、购买意向与产品反馈分别定义提取规则。' },
  { title: 'AI 工作流', description: '把模型分析、原帖核对和人工跟进接进业务流程。' },
  { title: '数据治理', description: '给分散表格里的产品、记录和出处建立关联。' },
];
const facts = [
  { title: '在深圳做产品', body: '现任世野科技数字化产品工程师，关注企业效率工具与 AI 应用。', image: platform.cover, alt: 'WESION 中台的 Bug 主题分析界面', credit: platform.title },
  { title: '从体验设计出发', body: '在阿卡索参与在线学习产品的设计与用户研究，在有赞和辰海云梳理企业业务流程。', image: learning.cover, alt: 'K12 在线英语学习平台原作品封面', credit: 'K12 在线英语学习平台' },
  { title: '把 AI 接进业务', body: '在 WeC Bot 四人团队中负责产品与 UX/UI，编写 Prompt、论坛分析规则并搭建工作流。', image: forum.cover, alt: 'WeC Bot 论坛分析的脱敏界面', credit: forum.title },
  { title: '持续验证产品', body: '借助 Codex 推进 WESION 的实现与调试，逐条核对 Bug 主题与原始记录的关联。中台仍在持续开发。', image: '/assets/wesion/bug-evidence.webp', alt: 'WESION 中台追溯原文依据的脱敏界面', credit: platform.title },
];
const skills = [
  { title: '用户研究与交互设计', tools: '用户研究 / 任务流程 / 交互原型', text: '先理解用户要完成什么，再决定页面怎样组织。在在线英语学习场景中，我从找课、上课和课后任务梳理学习路径。', example: learning, linkTitle: 'K12 在线英语学习平台' },
  { title: '企业流程与 SaaS 产品', tools: '服务预约 / 信息架构 / 业务状态', text: '同一次预约，顾客看可选服务与时间，商家要安排资源和处理变更。我从双方的任务出发整理流程、状态与信息层级。', example: booking, linkTitle: '有赞网店预约系统' },
  { title: 'Prompt 与 AI 工作流', tools: 'Prompt / 毕昇工作流 / 人工核对', text: '我把论坛帖子拆成客户求助、商机线索和产品反馈三个视角，让每类分析都有明确字段，并保留原帖供业务人员判断。', example: forum, linkTitle: forum.title },
  { title: '售后协作与知识维护', tools: '工单流转 / 角色权限 / 知识审核', text: '我把工单里的信息补充与责任转交拆开，为不同角色定义可执行的动作。知识维护则保留审核路径，供团队复核与更新答案。', example: forum, linkTitle: forum.title },
  { title: '数据治理与产品验证', tools: '数据口径 / 原文追溯 / Codex 辅助实现', text: '我为来源、产品名称和分析主题建立关联规则，借助 Codex 实现和调试，再回到原始记录检查 AI 的归纳。', example: platform, linkTitle: platform.title },
];
---
<Base>
  <div class="sky-home">
    <section class="sk-hero sk-width" id="home" aria-labelledby="hero-title" data-hero>
      <div class="sk-hero-pin" data-hero-pin>
        <div class="sk-hero-heading">
          <div>
            <p class="sk-eyebrow">{profile.title}</p>
            <h1 id="hero-title">周国翔 <span>/ Sky</span></h1>
            <p class="sk-statement"><strong>让复杂的业务，</strong><br />成为好用的产品。</p>
          </div>
          <div class="sk-crafts" data-crafts aria-label="六项工作能力">
            <div class="sk-craft-info">{crafts.map((craft, i) => <div data-craft-copy={i} hidden={i !== 0}><h2>{craft.title}</h2><p>{craft.description}</p></div>)}</div>
            <div class="sk-craft-controls" hidden>
              <div class="sk-dot-list" role="group" aria-label="选择能力">{crafts.map((craft, i) => <button type="button" data-craft-dot={i} aria-label={craft.title} aria-pressed={i === 0}><i aria-hidden="true"></i></button>)}</div>
              <button class="sk-play" type="button" data-craft-play aria-label="暂停自动切换" title="暂停自动切换"><span aria-hidden="true">Ⅱ</span></button>
            </div>
          </div>
        </div>
        <div class="sk-banner">
          {heroImage.src ? <img class="sk-banner-photo" src={heroImage.src} alt={heroImage.alt} fetchpriority="high" /> : <div class="sk-banner-art" aria-hidden="true">
            <div class="sk-sheet sk-sheet-a"><b>{forum.title}</b><img src={forum.cover} alt="" width="1168" height="480" fetchpriority="high" /></div>
            <div class="sk-sheet sk-sheet-b"><b>{platform.title}</b><img src={platform.cover} alt="" width="806" height="360" /></div>
          </div>}
          <div class="sk-banner-bottom"><div class="sk-actions"><a href="#work" class="sk-pill sk-primary">查看作品 <span aria-hidden="true">↘</span></a><a href="#contact" class="sk-pill sk-secondary">联系我 <span aria-hidden="true">↗</span></a></div>{!heroImage.src && <span class="sk-banner-caption">WeC Bot / WESION AI 中台 · 脱敏界面</span>}</div>
        </div>
      </div>
    </section>

    <StoryStack />

    <section class="sk-facts sk-width" id="facts" aria-labelledby="facts-title" data-facts>
      <div class="sk-facts-pin" data-facts-pin>
        <div class="sk-section-head"><h2 id="facts-title">职业速览</h2><a class="sk-inline-link" href="/about/">完整履历 <span aria-hidden="true">↗</span></a></div>
        <div class="sk-fact-stage">
          <div class="sk-fact-list" aria-label="职业速览条目">
            {facts.map((fact, i) => <article class="sk-fact-item" data-fact-item={i}><h3><span class="sk-fact-number">{String(i + 1).padStart(2, '0')}</span><span>{fact.title}</span></h3><p>{fact.body}</p><button type="button" class="sk-fact-select" hidden data-fact-select={i} aria-label={`查看：${fact.title}`}></button></article>)}
          </div>
          <div class="sk-fact-window" aria-hidden="true">
            {facts.map((fact, i) => <div data-fact-image={i} class:list={['sk-fact-image', {'is-current': i === 0}]}><img src={fact.image} alt="" width="900" height="560" loading="lazy" /><span>{fact.credit}</span></div>)}
          </div>
        </div>
      </div>
    </section>

    <section id="skills" class="sk-skills sk-width" aria-labelledby="skills-title">
      <h2 id="skills-title">我做什么</h2>
      <div class="sk-skill-list">{skills.map((skill, i) => <details class="sk-skill" name="work-skills" open={i === 0}><summary>{skill.title}<i aria-hidden="true"></i></summary><div class="sk-skill-detail"><p>{skill.text}</p><span>{skill.tools}</span><a href={skill.example.href}>{skill.linkTitle} <b aria-hidden="true">↗</b></a></div></details>)}</div>
    </section>

    <section id="work" class="sk-selected" aria-labelledby="work-title" data-projects>
      <div class="sk-selected-pin" data-projects-pin>
        <div class="sk-width sk-section-head"><h2 id="work-title">精选作品</h2><a class="sk-inline-link" href="/work/">全部 {works.length} 件作品 <span aria-hidden="true">↗</span></a></div>
        <div class="sk-project-viewport" data-projects-viewport aria-label="精选作品列表">
          <div class="sk-project-track" data-projects-track>{selected.map(({ work, title, subject, note, meta }, i) => <article class="sk-work-card" data-work-card={i}>
            <a class="sk-work-image" data-design={work.id} data-work-preview={work.id} href={work.href} aria-label={`阅读${title}`}><img src={work.cover} alt={title} loading="lazy" width="1000" height="560" /></a>
            <div class="sk-card-detail"><span class="sk-card-subject">{subject}</span><h3><a href={work.href} data-work-preview={work.id}>{title} <span aria-hidden="true">↗</span></a></h3><p>{note}</p><small>{meta}</small></div>
          </article>)}</div>
        </div>
        <div class="sk-width sk-project-controls" hidden><span data-project-counter aria-hidden="true">01 / {String(selected.length).padStart(2, '0')}</span><div><button data-project-prev aria-label="上一件作品">←</button><button data-project-next aria-label="下一件作品">→</button></div></div>
      </div>
    </section>
    {selected.map(({ work, title, subject, note }) => <dialog class="sk-summary" data-work-dialog={work.id} aria-labelledby={`summary-${work.id}`}>
      <div class="sk-summary-inner">
        <button class="sk-summary-close" type="button" aria-label="关闭项目摘要">×</button>
        <img class="sk-summary-image" src={work.cover} loading="lazy" alt={title} width="900" height="480" />
        <div class="sk-summary-copy"><span>{subject}</span><h2 id={`summary-${work.id}`}>{title}</h2><p>{work.summary || note}</p>
          <dl>{work.role && <div><dt>我的角色</dt><dd>{work.role}</dd></div>}
          {work.stage ? <div><dt>项目阶段</dt><dd>{work.stage}</dd></div> : <div><dt>原文发布日期</dt><dd>{work.published}</dd></div>}</dl>
          <a class="sk-pill sk-primary" href={work.href}>阅读完整案例 <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </dialog>)}
    <div class="sk-width"><Contact /></div>
  </div>
</Base>
<script>
  import { mountHome } from '../components/home-motion';
  mountHome();
</script>
