---
import Base from '../layouts/Base.astro';
import '../styles/reading.css';
import entries from '../data/legacy.json';
import images from '../data/legacy-images.json';
const summaries = {
  'ce-shi': {
    title: 'K12 在线英语学习平台',
    label: 'INTERACTION DESIGN / 在线学习',
    summary: '围绕在线英语学习产品开展交互设计与用户研究，从内容生产到学习任务，梳理清晰的操作路径。以下保留原作品集中的设计图，用于展示当时的交互与体验设计积累。',
    points: [
      ['理解任务', '结合用户研究梳理学习任务与使用场景。'],
      ['组织流程', '围绕运营模板编辑器、PC 导航与学习中心等场景优化操作路径。'],
      ['沉淀方法', '推动交互组件库、体验模型与度量框架建设。'],
    ],
  },
  'b-duan-hou-tai-she-ji-gui-fan': {
    title: '长春 B 端后台设计',
    label: 'SYSTEM & EXPERIENCE / 设计规范',
    summary: '面向智慧城市后台梳理设计语言、交互规范与组件体系。不同业务模块需要保持各自功能，同时形成清晰、一致的使用体验。以下保留原设计规范与页面作品。',
    points: [
      ['理解复杂业务', '梳理不同业务后台的内容框架与组件，识别可以复用的结构。'],
      ['建立设计语言', '通过交互规范和组件体系，为后台页面建立一致的表达。'],
      ['连接设计与实现', '用设计规范支持跨模块协作，兼顾体验一致性与实现成本。'],
    ],
  },
};
export function getStaticPaths() {
  return entries.map(entry => ({ params: { legacy: entry.slug } }));
}
const slug = Astro.params.legacy as keyof typeof summaries;
const selected = summaries[slug];
const entry = entries.find(p => p.slug === slug)!;
const detail = selected || {title:entry.title,label:'DESIGN ARCHIVE / 历史作品',summary:'保留原作品说明与设计素材。',points:[]};
const groups = images[slug as keyof typeof images];
const sorted = [...entries].sort((a,b)=>b.published.localeCompare(a.published));
const index = sorted.findIndex(e=>e.slug===slug);
const previous=sorted[index-1]; const next=sorted[index+1];
---
<Base title={detail.title} description={detail.summary}>
  <div class="wrap reading-page">
    <header class="legacy-header"><a class="back-link" href="/archives/">← 返回设计作品归档</a><p class="eyebrow">{detail.label}</p><h1>{detail.title}</h1><p class="legacy-summary">{detail.summary}</p>
      <p class="source-date">历史设计作品 · 原页面发布于 {entry.published}（非项目交付日期）</p>
      {detail.points.length > 0 && <div class="legacy-points">{detail.points.map(([title,text]) => <div><h2>{title}</h2><p>{text}</p></div>)}</div>}
    </header>
    <section class="legacy-reading" aria-label="原设计作品图集"><p class="eyebrow">ORIGINAL WORK / 设计作品</p>
      {entry.blocks.map(block => block.type === 'text' ? <p class="legacy-source-text">{block.text}</p> : <figure class="legacy-image-group">
        <a class="legacy-original" href={groups[block.index!].original} target="_blank" rel="noopener" tabindex="-1" aria-label={`打开${detail.title}第 ${block.index!+1} 张原图`}>
          {groups[block.index!].slices.map((slice,n) => <img src={slice.src} width={slice.width} height={slice.height} loading="lazy" decoding="async" alt={`${detail.title}，原作品第 ${block.index!+1} 张，第 ${n+1} 部分`} />)}
        </a>
        <figcaption><span>原设计作品 · {String(block.index!+1).padStart(2,'0')}</span><a href={groups[block.index!].original} target="_blank" rel="noopener">查看原图 ↗</a></figcaption>
      </figure>)}
      <p class="source-date">保留原设计资料，当前文字不新增历史业务效果或量化成果。</p>
    </section>
    <nav class="legacy-pagination" aria-label="作品翻页">{previous ? <a href={`/${previous.slug}/`}>← 上一篇：{previous.title}</a> : <a href="/archives/">← 返回全部作品</a>}{next ? <a href={`/${next.slug}/`}>下一篇：{next.title} →</a> : <a href="/archives/">返回全部作品 →</a>}</nav>
    <a class="next-case" href="/work/"><div><h2>作品地图</h2><p>继续查看 WeC Bot 与 WESION AI 中台案例。</p></div><span aria-hidden="true">↗</span></a>
  </div>
</Base>
