---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import '../../styles/reading.css';
import ProjectVisual from '../../components/ProjectVisual.astro';
import CaseTabs from '../../components/CaseTabs.astro';
export async function getStaticPaths() {
  const all = (await getCollection('projects')).sort((a,b) => a.data.order - b.data.order);
  return all.map((project, i) => ({ params: { id: project.id }, props: { project, next: all[(i + 1) % all.length] } }));
}
const { project, next } = Astro.props;
const { Content, headings } = await render(project);
---
<Base title={project.data.title} description={project.data.summary}>
  <div class="wrap reading-page">
    <header class="case-header">
      <a class="back-link" href="/work/">← 返回作品地图</a>
      <p class="eyebrow">CASE STUDY / {String(project.data.order).padStart(2,'0')}</p>
      <h1>{project.data.title}</h1><p class="case-subtitle">{project.data.subtitle}</p>
      <p class="case-description">{project.data.summary}</p>
      <dl class="case-meta"><div><dt>我的角色</dt><dd>{project.data.role}</dd></div><div><dt>项目阶段</dt><dd>{project.data.period}</dd></div><div><dt>交付与使用</dt><dd>{project.data.stage}</dd></div></dl>
    </header>
    <ProjectVisual type={project.id} large />
    <div class="case-body">
      <aside class="case-nav"><nav aria-label="案例章节"><p class="eyebrow">章节目录</p>{headings.filter(h => h.depth === 2).map((h,i) => <a href={`#${h.slug}`}><span>{String(i+1).padStart(2,'0')}</span>{h.text}</a>)}</nav></aside>
      <article class="prose">{project.id === 'wesion-ai' ? <CaseTabs><Content /></CaseTabs> : <Content />}</article>
    </div>
    <a class="next-case" href={`/work/${next.id}/`}><div><p class="eyebrow">NEXT CASE / 下一篇案例</p><h2>{next.data.title}</h2><p>{next.data.subtitle}</p></div><span aria-hidden="true">↗</span></a>
  </div>
</Base>
